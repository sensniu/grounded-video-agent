# Copy this file to .env and fill in local values. Never commit real secrets.
DEEPSEEK_API_KEY=

# Change to 1 only when intentionally running the paid DeepSeek integration test.
RUN_DEEPSEEK_INTEGRATION=0

# Runs the local sample through the full Agent with a Fake LLM; no paid API is used.
RUN_VIDEO_AGENT_INTEGRATION=0

# CLI configuration. Command-line options override these values.
GVA_INPUT_ROOT=analyzed_video
GVA_ARTIFACT_ROOT=artifacts
GVA_DEEPSEEK_MODEL=deepseek-v4-flash
GVA_DEEPSEEK_BASE_URL=https://api.deepseek.com
GVA_OCR_BACKEND=off
GVA_VLM_BACKEND=off
GVA_LLAMA_CPP_BASE_URL=http://127.0.0.1:8080
# GVA_LLAMA_CPP_MODEL_ID=
